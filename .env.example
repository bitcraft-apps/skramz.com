# Shared infra config (root). API secrets go in api/.env (loaded last, wins).
DATABASE_URL=postgres://skramz:skramz@localhost:5432/skramz?sslmode=disable
API_PORT=8080
# R2 (cover art / band photos)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=skramz-media
# Cloudflare Tunnel token (Hetzner VPS, secret — never commit)
TUNNEL_TOKEN=
# Public API base URL for the Next.js frontend (served via Tunnel hostname)
NEXT_PUBLIC_API_URL=https://api.skramz.com
